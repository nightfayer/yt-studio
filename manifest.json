{
  "manifest_version": 3,
  "name": "YT Studio",
  "version": "2.1.3",
  "description": "Скачивание видео/аудио/субтитров YouTube, Rutube, Twitch, VK, TikTok, Instagram, Coub и Zvuk, запись трансляций — без внешних сервисов",
  "permissions": [
    "downloads",
    "offscreen",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://rutube.ru/*",
    "https://rutube.sport/*",
    "https://*.rutube.ru/*",
    "https://*.rtbcdn.ru/*",
    "https://coub.com/*",
    "https://*.coub.com/*",
    "https://vkvideo.ru/*",
    "https://*.vkvideo.ru/*",
    "https://vk.com/*",
    "https://zvuk.com/*",
    "https://*.zvuk.com/*",
    "https://www.tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokcdn-eu.com/*",
    "https://*.tiktokv.com/*",
    "https://*.tiktokv.us/*",
    "https://*.byteoversea.com/*",
    "https://*.ibyteimg.com/*",
    "https://www.instagram.com/*",
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "quick-download": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Быстрое открытие меню скачивания"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content_ui.js"
      ],
      "css": [
        "content_ui.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://rutube.ru/*",
        "https://rutube.sport/*"
      ],
      "js": [
        "settings.js",
        "rutube.js"
      ],
      "css": [
        "rutube.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*"
      ],
      "js": [
        "settings.js",
        "twitch_ui.js"
      ],
      "css": [
        "twitch_ui.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://coub.com/*"
      ],
      "js": [
        "coub.js"
      ],
      "css": [
        "coub.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://vkvideo.ru/*",
        "https://*.vkvideo.ru/*",
        "https://vk.com/video*",
        "https://vk.com/clip*"
      ],
      "js": [
        "settings.js",
        "vk.js"
      ],
      "css": [
        "vk.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://zvuk.com/*"
      ],
      "js": [
        "zvuk.js"
      ],
      "css": [
        "zvuk.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "tiktok.js"
      ],
      "css": [
        "tiktok.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "instagram_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "settings.js",
        "instagram.js"
      ],
      "css": [
        "instagram.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

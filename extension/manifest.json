{
  "manifest_version": 3,
  "name": "YT Studio — Быстрое скачивание видео",
  "version": "1.0.0",
  "description": "Скачивание видео и MP3/M4A в один клик с YouTube, VK Видео, Rutube и Twitch через локальный YT Studio",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "YT Studio"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.youtube.com/*",
    "*://*.vk.com/*",
    "*://*.vkvideo.ru/*",
    "*://*.rutube.ru/*",
    "*://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.vk.com/*",
        "*://*.vkvideo.ru/*",
        "*://*.rutube.ru/*",
        "*://*.twitch.tv/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
